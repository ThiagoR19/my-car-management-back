DATABASE_URL=mysql://usuario:contrasena@localhost:3306/my-car-management
PORT=3000

# Alta inicial explícita: completar temporalmente y ejecutar npm run setup:admin.
# Retirar estas variables después del alta; no se crean cuentas demo.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Servidor SMTP propio. Reiniciar la API después de modificar estas variables.
SMTP_HOST=
SMTP_PORT=587
# true para TLS directo en el puerto 465; false para STARTTLS en el 587.
# Si se deja vacío, se usa true en el puerto 465 y false en los demás.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Dejar ambos vacíos si usás un relay propio que autoriza al servidor por IP.
SMTP_USER=
SMTP_PASS=
# Dirección simple, sin nombre ni signos <>.
SMTP_FROM=
SMTP_FROM_NAME=MyCarManagement
# Si SMTP_HOST es una IP, indicar el nombre del certificado TLS.
SMTP_TLS_SERVERNAME=
